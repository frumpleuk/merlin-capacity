    {
      "name": "Breakfast",
      "note": "Hot drinks: 100% Arabica coffee, decaffeinated coffee, hot chocolate or plant-based alternative, café au lait or plant-based alternative, tea, herbal tea, semi-skimmed milk or plant-based alternative 20 cl",
      "items": [
        {
          "name": "Adult",
          "description": "Croissant and bread roll; butter, honey; stewed apricots in cane sugar and strawberry preserve with cane sugar; fresh orange juice or apple juice; hot drink. And savory option: smoked salmon and dill cream on Nordic bread, 12-month-aged Comté AOP, thinly-sliced cooked ham, soft-boiled egg, English muffin, beef bacon and hollandaise sauce; or sweet option: seasonal fruit salad, pancakes, blueberries and maple syrup; or duo option (vegan): silken tofu with cashew nuts, banana, kiwi and other fresh fruit, gluten-free muesli and goji berries, plant-based omelette with mushrooms, tomatoes and chives",
          "price": 6000
        },
        {
          "name": "Children",
          "description": "For children ages 3 to 11. Croissant and bread roll; butter, honey; stewed apricots in cane sugar and strawberry preserve with cane sugar; fresh orange juice or apple juice; hot drink. And thinly-sliced cooked ham with Kiri® and scrambled eggs; or seasonal fruit salad, pancake and chocolate sauce. Selection of cereals available on request",
          "price": 4800,
          "tags": [
            "kids"
          ]
        },
        {
          "name": "Mimosa",
          "description": "Special edition Disneyland® Paris Pierre Mignon Grande Réserve - brut and fresh orange juice",
          "price": 1600,
          "tags": [
            "alcohol"
          ]
        },
        {
          "name": "Champagne",
          "description": "Special edition Disneyland® Paris Pierre Mignon Grande Réserve - brut, 15 cl",
          "price": 1900,
          "tags": [
            "alcohol"
          ]
        }
      ]
    },
    {
      "name": "Royal Oak Set Menu",
      "items": [
        {
          "name": "Royal Oak Set Menu",
          "description": "Starters: courgette velouté, cauliflower tabbouleh with marigolds and a Colombo-spiced okra fritter (vegan); or bluefin tuna tataki with sesame seeds, daikon and wakame salad, pineapple and Sichuan peppercorn chutney; or Swiss salad: raw and pickled fruit and vegetables, Grisons cured beef, Tête de Moine cheese, raspberry vinegar dressing and pine nuts; or avocado and ginger mousse, mango tartare and pumpkin seed crumble with creamy dill oil sauce (veggie). Main courses: gilthead seabream, kaffir lime and vanilla sauce, sweet potato purée and braised bok choy; or North African-style roast guinea fowl with dried fruits and lemon confit; or slow-cooked beef at low temperature with onion confit, red wine sauce, potato pancake with Comté AOP and thyme; or soy and pea fillet, herb crust and black garlic broth, pan-fried barley with mushrooms, chard and truffle, beer foam (vegan). Desserts: vanilla ganache mousse cake, raspberry insert, crispy praline; or tropical fruit and aloe vera salad, coconut emulsion (vegan); or white chocolate, pineapple-passion fruit, almond and coconut mousse cake; or marc de champagne frozen soufflé (veggie)",
          "price": 10000
        },
        {
          "name": "Wine Pairing",
          "description": "Menu served with three 8 cl glasses of wine. Starters: white AOC Cheverny - Château de Chambord - Sauvignon Blanc - Bio or rosé AOP Côtes de Provence - Minuty - Prestige Rosé. Main courses: white AOC Pouilly-Fuissé - Domaine de la Denante or red AOC Saint-Émilion Grand Cru - Château Capet-Guillier. Desserts: white AOC Alsace - Gewurztraminer - Vendange Tardive - Famille Hugel or Pierre Mignon - Ratafia de Champagne",
          "price": 2500,
          "tags": [
            "alcohol"
          ],
          "addOn": true
        },
        {
          "name": "Champagne Pairing",
          "description": "Menu served with three 10 cl glasses of champagne. Starters: Édition Spéciale Disneyland® Paris - Pierre Mignon Grande Réserve - brut. Main courses: Moët & Chandon - Grand Vintage - extra brut or Louis Roederer - Collection 246 - brut. Desserts: Taittinger - Prestige Rosé or Pierre Mignon - Ratafia de Champagne",
          "price": 4000,
          "tags": [
            "alcohol"
          ],
          "addOn": true
        },
        {
          "name": "Birthday Dessert",
          "description": "Order your birthday dessert before your meal",
          "sizes": [
            {
              "label": "To share for 2 or more people",
              "price": 2500
            },
            {
              "label": "To share for 6 or more people",
              "price": 4500
            }
          ]
        }
      ]
    },
    {
      "name": "Prince's Elm Menu",
      "items": [
        {
          "name": "Prince's Elm Menu",
          "description": "For children ages 3 to 11. Starter, main course, dessert and drink. Starters: green pea velouté with okra fritter (vegan), rolled vegetable omelette with mayonnaise and pastrami or fish rillettes with smoked salmon and cocktail sauce; main courses: conchiglie pasta with ricotta cheese, red and yellow tomato sauce, haddock fillet with citrus sauce, yellow carrot purée and purple cauliflower or pulled chicken with buttery mashed potatoes, pan jus and toast strip; desserts: almond sponge cake with white chocolate mousse and blueberry centre, seasonal fruit tartlet with mascarpone mousse or milk chocolate mousse with caramelised puff pastry; drinks: Vittel® 33 cl, orange or apple juice 25 cl or milk 20 cl. Another cold drink 25cl is available upon request as a replacement for the product offered",
          "price": 5000,
          "tags": [
            "kids"
          ]
        }
      ]
    },
