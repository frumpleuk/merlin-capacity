{
  "name": "merlin-capacity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/menus/build.mjs",
    "build": "vite build",
    "dev:api": "wrangler dev",
    "dev:web": "vite",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "postdeploy": "npm run publish:menus",
    "publish:menus": "node scripts/menus/publish.mjs",
    "deploy:ci": "wrangler d1 migrations apply merlin-capacity --remote && wrangler deploy && npm run publish:menus",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "check:park": "esbuild scripts/check-park.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-park.mjs --log-level=warning && node node_modules/.cache/check-park.mjs",
    "db:migrate": "wrangler d1 migrations apply merlin-capacity --remote",
    "db:migrate:local": "wrangler d1 migrations apply merlin-capacity --local"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "wrangler": "4.148.0"
  }
}
